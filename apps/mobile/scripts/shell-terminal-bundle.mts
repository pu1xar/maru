// Builds src/shell/xtermBundle.generated.ts: the xterm.js terminal and its fit addon as three
// strings, so the shell screen's WebView page carries them and opens with no network (DESIGN.md
// 6s). The files come from the packages the web installs (apps/web/node_modules/@xterm), so the
// app's terminal is the web's version by construction; shell-terminal-bundle.test.mts compares the
// committed output with a fresh build and the versions with apps/web/package.json.
//
//   node scripts/shell-terminal-bundle.mts          write the file
//   node scripts/shell-terminal-bundle.mts --check  exit 1 when the file is not what a build gives
import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";

const here = path.dirname(fileURLToPath(import.meta.url));
export const MOBILE_ROOT = path.resolve(here, "..");
export const WEB_ROOT = path.resolve(MOBILE_ROOT, "../web");
export const BUNDLE_FILE = path.join(MOBILE_ROOT, "src/shell/xtermBundle.generated.ts");

/** The part of a minified file the page does not need: the source map comment. */
function withoutSourceMap(text: string): string {
  return text.replace(/\n?\/\/# sourceMappingURL=\S+\s*$/, "");
}

function read(file: string): string {
  return fs.readFileSync(file, "utf8");
}

function versionOf(pkgDir: string): string {
  return (JSON.parse(read(path.join(pkgDir, "package.json"))) as { version: string }).version;
}

/** The generated module's text for the xterm packages under `webRoot`. */
export function bundleSource(webRoot: string = WEB_ROOT): string {
  const xterm = path.join(webRoot, "node_modules/@xterm/xterm");
  const fit = path.join(webRoot, "node_modules/@xterm/addon-fit");
  const parts = {
    XTERM_JS: withoutSourceMap(read(path.join(xterm, "lib/xterm.js"))),
    XTERM_FIT_JS: withoutSourceMap(read(path.join(fit, "lib/addon-fit.js"))),
    XTERM_CSS: read(path.join(xterm, "css/xterm.css")),
  };
  return [
    "// Generated by scripts/shell-terminal-bundle.mts from the @xterm packages apps/web installs. Do not edit.",
    "// The shell screen's WebView page (shellPage.ts) inlines these (DESIGN.md 6s).",
    `export const XTERM_VERSION = ${JSON.stringify(versionOf(xterm))};`,
    `export const XTERM_FIT_VERSION = ${JSON.stringify(versionOf(fit))};`,
    ...Object.entries(parts).map(([name, text]) => `export const ${name} = ${JSON.stringify(text)};`),
    "",
  ].join("\n");
}

if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
  const next = bundleSource();
  if (process.argv.includes("--check")) {
    const current = fs.existsSync(BUNDLE_FILE) ? read(BUNDLE_FILE) : "";
    if (current !== next) {
      console.error(`${path.relative(process.cwd(), BUNDLE_FILE)} is out of date: run node scripts/shell-terminal-bundle.mts`);
      process.exit(1);
    }
    console.log("shell terminal bundle is up to date");
  } else {
    fs.mkdirSync(path.dirname(BUNDLE_FILE), { recursive: true });
    fs.writeFileSync(BUNDLE_FILE, next);
    console.log(`wrote ${path.relative(process.cwd(), BUNDLE_FILE)} (${next.length} bytes)`);
  }
}
