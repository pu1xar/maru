// Builds src/mermaid/peleBundle.generated.ts: the Pele diagram renderer and DOMPurify as two strings,
// so the diagram sheet's WebView page carries them and opens with no network (DESIGN.md 7g). The
// files come from the packages the web installs (apps/web/node_modules/pele and dompurify), so the
// app draws with the web's renderer version by construction; mermaid-bundle.test.mts compares the
// committed output with a fresh build and the versions with apps/web/package.json. Same shape as
// shell-terminal-bundle.mts (the xterm strings of the shell screen).
//
//   node scripts/mermaid-bundle.mts          write the file
//   node scripts/mermaid-bundle.mts --check  exit 1 when the file is not what a build gives
import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";

const here = path.dirname(fileURLToPath(import.meta.url));
export const MOBILE_ROOT = path.resolve(here, "..");
export const WEB_ROOT = path.resolve(MOBILE_ROOT, "../web");
export const BUNDLE_FILE = path.join(MOBILE_ROOT, "src/mermaid/peleBundle.generated.ts");

/** The part of a minified file the page does not need: the source map comment. */
function withoutSourceMap(text: string): string {
  return text.replace(/\n?\/\/# sourceMappingURL=\S+\s*$/, "");
}

/**
 * The file with each non-ASCII character written as a \uXXXX escape. The characters sit inside
 * string and regex literals (Pele's CJK line-break tables), where the escape means the same thing.
 * The string is then pure ASCII, which Hermes keeps at one byte per character in the app's
 * bytecode (a string with any other character takes two): about 0.7 MB less in the update.
 */
export function asciiEscaped(text: string): string {
  return text.replace(/[^\x00-\x7f]/g, (c) => `\\u${c.charCodeAt(0).toString(16).padStart(4, "0")}`);
}

function read(file: string): string {
  return fs.readFileSync(file, "utf8");
}

function versionOf(pkgDir: string): string {
  return (JSON.parse(read(path.join(pkgDir, "package.json"))) as { version: string }).version;
}

/** The generated module's text for the pele and dompurify packages under `webRoot`. */
export function bundleSource(webRoot: string = WEB_ROOT): string {
  const pele = path.join(webRoot, "node_modules/pele");
  const purify = path.join(webRoot, "node_modules/dompurify");
  const parts = {
    PELE_JS: asciiEscaped(withoutSourceMap(read(path.join(pele, "dist/pele.global.js")))),
    PURIFY_JS: asciiEscaped(withoutSourceMap(read(path.join(purify, "dist/purify.min.js")))),
  };
  return [
    "// Generated by scripts/mermaid-bundle.mts from the pele and dompurify packages apps/web installs. Do not edit.",
    "// The diagram sheet's WebView page (mermaid/page.ts) inlines these (DESIGN.md 7g).",
    `export const PELE_VERSION = ${JSON.stringify(versionOf(pele))};`,
    `export const PURIFY_VERSION = ${JSON.stringify(versionOf(purify))};`,
    ...Object.entries(parts).map(([name, text]) => `export const ${name} = ${JSON.stringify(text)};`),
    "",
  ].join("\n");
}

if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
  const next = bundleSource();
  if (process.argv.includes("--check")) {
    const current = fs.existsSync(BUNDLE_FILE) ? read(BUNDLE_FILE) : "";
    if (current !== next) {
      console.error(`${path.relative(process.cwd(), BUNDLE_FILE)} is out of date: run node scripts/mermaid-bundle.mts`);
      process.exit(1);
    }
    console.log("mermaid bundle is up to date");
  } else {
    fs.mkdirSync(path.dirname(BUNDLE_FILE), { recursive: true });
    fs.writeFileSync(BUNDLE_FILE, next);
    console.log(`wrote ${path.relative(process.cwd(), BUNDLE_FILE)} (${next.length} bytes)`);
  }
}
