{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "paths": {
      "@maru/shared": ["../../packages/shared/src/index.ts"]
    }
  },
  "include": ["index.ts", "app.config.ts", "src/**/*.ts", "src/**/*.tsx", "scripts/**/*.mts"]
}
